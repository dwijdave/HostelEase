@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool isAdmin = User.IsInRole("Admin");
    string Active(string c, string a = null) => controller == c && (a == null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HostelEase</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<aside class="sidebar" id="sidebar">
    <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="logo"><i class="bi bi-buildings"></i></span>HostelEase</a>
    <nav class="nav flex-column">
        @if (isAdmin)
        {
            <div class="nav-label">Overview</div>
            <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
            <a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i>Reports</a>
            <div class="nav-label">Manage</div>
            <a class="nav-link @Active("Student")" asp-controller="Student" asp-action="Index"><i class="bi bi-people"></i>Students</a>
            <a class="nav-link @Active("Hostel", "Index") @Active("Hostel", "Create") @Active("Hostel", "Edit")" asp-controller="Hostel" asp-action="Index"><i class="bi bi-building"></i>Hostels</a>
            <a class="nav-link @Active("Hostel", "Blocks") @Active("Hostel", "CreateBlock") @Active("Hostel", "EditBlock")" asp-controller="Hostel" asp-action="Blocks"><i class="bi bi-grid-3x3-gap"></i>Blocks</a>
            <a class="nav-link @Active("Room")" asp-controller="Room" asp-action="Index"><i class="bi bi-door-open"></i>Rooms</a>
            <div class="nav-label">Allocation</div>
            <a class="nav-link @Active("Allocation", "Index") @Active("Allocation", "Review")" asp-controller="Allocation" asp-action="Index"><i class="bi bi-inbox"></i>Requests</a>
            <a class="nav-link @Active("Allocation", "Allocations")" asp-controller="Allocation" asp-action="Allocations"><i class="bi bi-key"></i>Allocations</a>
            <a class="nav-link @Active("Complaint")" asp-controller="Complaint" asp-action="Index"><i class="bi bi-chat-left-text"></i>Complaints</a>
            <div class="nav-label">Account</div>
            <a class="nav-link @Active("Account", "CreateAdmin")" asp-controller="Account" asp-action="CreateAdmin"><i class="bi bi-person-gear"></i>Add administrator</a>
        }
        else
        {
            <div class="nav-label">Student</div>
            <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
            <a class="nav-link @Active("Room", "Available")" asp-controller="Room" asp-action="Available"><i class="bi bi-door-open"></i>Browse rooms</a>
            <a class="nav-link @Active("Allocation", "Apply")" asp-controller="Allocation" asp-action="Apply"><i class="bi bi-send"></i>Request a room</a>
            <a class="nav-link @Active("Allocation", "My")" asp-controller="Allocation" asp-action="My"><i class="bi bi-clock-history"></i>My requests</a>
            <a class="nav-link @Active("Complaint")" asp-controller="Complaint" asp-action="My"><i class="bi bi-chat-left-text"></i>My complaints</a>
            <div class="nav-label">Account</div>
            <a class="nav-link @Active("Account", "Profile")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i>My profile</a>
        }
        <a class="nav-link @Active("Account", "ChangePassword")" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-shield-lock"></i>Change password</a>
    </nav>
    <div class="user-box">
        <div class="fw-semibold text-white">@User.FullName()</div>
        <div class="small">@(isAdmin ? "Administrator" : "Student") &middot; @User.Identity.Name</div>
        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
            <button class="btn btn-sm btn-outline-light w-100"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button>
        </form>
    </div>
</aside>

<div class="main">
    <header class="topbar">
        <button class="btn btn-light d-lg-none" type="button" data-toggle-sidebar aria-label="Menu"><i class="bi bi-list fs-5"></i></button>
        <h1>@ViewData["Title"]</h1>
        <span class="ms-auto badge text-bg-light border d-none d-sm-inline">@(isAdmin ? "Admin panel" : "Student portal")</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            <button class="btn btn-outline-secondary btn-sm" title="Sign out"><i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-sm-inline">Sign out</span></button>
        </form>
    </header>
    <main class="content">
        @foreach (var (key, css, icon) in new[] { ("Success", "success", "check-circle"), ("Error", "danger", "exclamation-triangle"), ("Info", "info", "info-circle") })
        {
            if (TempData[key] is string msg)
            {
                <div class="alert alert-@css alert-dismissible fade show @(key == "Success" ? "auto-dismiss" : "")" role="alert">
                    <i class="bi bi-@icon me-1"></i>@msg
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        }
        @RenderBody()
    </main>
    <div class="footer">HostelEase &middot; Smart Hostel Allocation &amp; Management System &middot; 01CE15230 .NET Technologies</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
