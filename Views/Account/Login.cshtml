@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; Layout = "_AuthLayout"; }
<h2 class="fw-bold">Welcome back</h2>
<p class="text-muted mb-4">Sign in to your HostelEase account.</p>
<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <button class="btn btn-outline-secondary" type="button" data-toggle-password="#Password" aria-label="Show or hide password"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <button class="btn btn-primary w-100 py-2">Sign in</button>
</form>
<p class="mt-3 text-center">New student? <a asp-action="Register">Create an account</a></p>
@if (Context.RequestServices.GetService<IWebHostEnvironment>().IsDevelopment())
{
    <div class="card card-body bg-light small mt-4">
        <div class="fw-semibold mb-1"><i class="bi bi-info-circle"></i> Demo accounts (development only)</div>
        <div>Admin: <code>admin@hostelease.com</code> / <code>Admin@123</code></div>
        <div>Student: <code>student@hostelease.com</code> / <code>Student@123</code></div>
    </div>
}
