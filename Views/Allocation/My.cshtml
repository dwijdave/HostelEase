@model List<AllocationRequest>
@{ ViewData["Title"] = "My requests"; var current = ViewBag.Current as Allocation; bool hasPending = Model.Any(r => r.Status == "Pending"); }
@if (current != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill fs-5"></i><div><b>You are allocated to @current.RoomLabel</b><div class="small">Since @current.AllocationDate.ToString("dd MMM yyyy")</div></div></div>
}
else if (!hasPending)
{
    <div class="page-actions"><div class="text-muted">You have no pending request.</div><a class="btn btn-primary" asp-action="Apply"><i class="bi bi-send"></i> Request a room</a></div>
}
@if (Model.Any())
{
    foreach (var r in Model)
    {
        bool approved = r.Status == "Approved", rejected = r.Status == "Rejected", cancelled = r.Status == "Cancelled";
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <div><div class="fw-semibold">Request #@r.RequestID &middot; @(r.PreferredRoomLabel ?? r.PreferredHostelName ?? "No preference")</div><div class="small text-muted">Submitted @r.RequestDate.ToString("dd MMM yyyy, HH:mm")</div></div>
                <div><partial name="_StatusBadge" model="r.Status" /></div>
            </div>
            <div class="status-track">
                <div class="step done">Submitted</div>
                <div class="step @(r.Status == "Pending" ? "done" : "done")">Under review</div>
                <div class="step @(approved ? "done ok" : rejected ? "done bad" : cancelled ? "done bad" : "")">@(approved ? "Approved" : rejected ? "Rejected" : cancelled ? "Cancelled" : "Decision")</div>
            </div>
            @if (!string.IsNullOrEmpty(r.AdminRemarks)) { <div class="alert alert-light border mt-3 mb-0 small"><b>Administrator remarks:</b> @r.AdminRemarks</div> }
            @if (r.Status == "Pending")
            {
                <form asp-action="Cancel" method="post" class="mt-3" onsubmit="return confirm('Cancel this request?');"><input type="hidden" name="id" value="@r.RequestID" /><button class="btn btn-sm btn-outline-danger">Cancel request</button></form>
            }
        </div></div>
    }
}
else { <div class="card"><div class="empty-state"><i class="bi bi-inbox"></i>You have not sent any requests yet.</div></div> }
