@model List<Allocation>
@{ ViewData["Title"] = "Room allocations"; string status = ViewBag.Status; }
<div class="page-actions">
    <form method="get" class="d-flex flex-wrap gap-2 filter-bar">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Student, room or hostel" />
        <select name="status" class="form-select"><option value="">All</option><option value="Active" selected="@(status == "Active")">Active</option><option value="Ended" selected="@(status == "Ended")">Ended</option></select>
        <button class="btn btn-outline-primary"><i class="bi bi-funnel"></i> Filter</button>
    </form>
    <a class="btn btn-outline-secondary" asp-controller="Reports" asp-action="ExportAllocations"><i class="bi bi-download"></i> Export CSV</a>
</div>
<div class="card">
@if (Model.Any())
{
    <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Student</th><th>Room</th><th>From</th><th>To</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach (var a in Model)
    {
        <tr><td class="fw-semibold">@a.StudentName<div class="small text-muted fw-normal">@a.StudentNumber</div></td><td>@a.RoomLabel</td><td class="small">@a.AllocationDate.ToString("dd MMM yyyy")</td><td class="small">@(a.EndDate?.ToString("dd MMM yyyy") ?? "-")</td>
            <td><partial name="_StatusBadge" model="a.Status" /></td>
            <td class="text-end">@if (a.Status == "Active") { <form asp-action="Vacate" method="post" onsubmit="return confirm('Vacate @a.StudentName from room @a.RoomNumber?');"><input type="hidden" name="id" value="@a.AllocationID" /><button class="btn btn-sm btn-outline-danger">Vacate</button></form> }</td></tr>
    }
    </tbody></table></div>
}
else { <div class="empty-state"><i class="bi bi-key"></i>No allocations found.</div> }
</div>
