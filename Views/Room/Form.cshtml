@model Room
@{ ViewData["Title"] = Model.RoomID == 0 ? "Add room" : "Edit room"; string[] statuses = ViewBag.Statuses; }
<div class="card" style="max-width:640px"><div class="card-body">
@if (Model.RoomID != 0 && ViewBag.Occupied is int occ) { <div class="alert alert-light border small">Currently occupied by <b>@occ</b> student(s).</div> }
<form asp-action="@(Model.RoomID == 0 ? "Create" : "Edit")" method="post" novalidate>
    <input type="hidden" asp-for="RoomID" />
    <div class="mb-3"><label asp-for="BlockID" class="form-label"></label>
        <select asp-for="BlockID" class="form-select" asp-items="@((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Blocks)"><option value="0">Select hostel / block...</option></select><span asp-validation-for="BlockID" class="text-danger"></span></div>
    <div class="row g-3 mb-3">
        <div class="col-md-5"><label asp-for="RoomNumber" class="form-label"></label><input asp-for="RoomNumber" class="form-control" /><span asp-validation-for="RoomNumber" class="text-danger"></span></div>
        <div class="col-md-3"><label asp-for="Capacity" class="form-label">Capacity (beds)</label><input asp-for="Capacity" type="number" min="1" max="20" class="form-control" /><span asp-validation-for="Capacity" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="@(statuses.Select(s => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(s, s)))"></select><span asp-validation-for="Status" class="text-danger"></span></div>
    </div>
    <button class="btn btn-primary">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a>
</form></div></div>
